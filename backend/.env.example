# MHEART Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME=MHEART
DEBUG=true
SECRET_KEY=change-this-secret-key-in-production

# Database
DATABASE__HOST=localhost
DATABASE__PORT=5432
DATABASE__USER=mheart
DATABASE__PASSWORD=mheart_password
DATABASE__DATABASE=mheart_db

# Redis
REDIS__HOST=localhost
REDIS__PORT=6379
REDIS__DB=0

# Ollama
OLLAMA__BASE_URL=http://localhost:11434
OLLAMA__MODEL=mistral
OLLAMA__TEMPERATURE=0.7
OLLAMA__MAX_TOKENS=500

# Whisper
WHISPER__MODEL_SIZE=base
WHISPER__DEVICE=auto
WHISPER__COMPUTE_TYPE=float16

# Paths
KNOWLEDGE_BASE_PATH=data/knowledge_base/guidelines.txt
VECTOR_DB_PATH=data/vector_db